class CameraSurface(QWidget):
    """Synthetic Optical & Thermal IR drone camera with AI detection bounding boxes."""

    mode_changed = pyqtSignal(str)

    def __init__(self) -> None:
        super().__init__()
        self.mode = "THERMAL"
        self.zoom = 96
        self.ai_enabled = True
        self.anim_tick = 0
        self.setMinimumHeight(155)
        self.setCursor(Qt.CursorShape.PointingHandCursor)

    def set_mode(self, mode: str) -> None:
        if mode not in {"OPTICAL", "THERMAL"}:
            return
        self.mode = mode
        self.update()

    def toggle_mode(self) -> None:
        self.mode = "THERMAL" if self.mode == "OPTICAL" else "OPTICAL"
        self.mode_changed.emit(self.mode)
        self.update()

    def mousePressEvent(self, event) -> None:  # type: ignore[override]
        self.toggle_mode()

    def tick(self) -> None:
        self.anim_tick = (self.anim_tick + 1) % 1000
        self.update()

    def paintEvent(self, event) -> None:  # type: ignore[override]
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        rect = self.rect()

        # 1. Base Environment Render
        if self.mode == "THERMAL":
            # Grayscale / FLIR thermal environment
            bg_gradient = QLinearGradient(QPointF(rect.topLeft()), QPointF(rect.bottomRight()))
            bg_gradient.setColorAt(0, QColor("#1e222d"))
            bg_gradient.setColorAt(0.5, QColor("#161a24"))
            bg_gradient.setColorAt(1, QColor("#0f121a"))
            p.fillRect(rect, bg_gradient)

            # Simulated warehouse corridor perspective lines
            p.setPen(QPen(QColor(255, 255, 255, 12), 1))
            vp_x, vp_y = rect.width() * 0.48, rect.height() * 0.28
            p.drawLine(QPointF(0, rect.height() * 0.85), QPointF(vp_x, vp_y))
            p.drawLine(QPointF(rect.width(), rect.height() * 0.85), QPointF(vp_x, vp_y))
            p.drawLine(QPointF(0, rect.height() * 0.35), QPointF(vp_x, vp_y))
            p.drawLine(QPointF(rect.width(), rect.height() * 0.35), QPointF(vp_x, vp_y))

            # Architectural pillars
            p.fillRect(QRectF(rect.width() * 0.12, rect.height() * 0.22, rect.width() * 0.05, rect.height() * 0.65), QColor("#222838"))
            p.fillRect(QRectF(rect.width() * 0.82, rect.height() * 0.20, rect.width() * 0.06, rect.height() * 0.68), QColor("#222838"))
            p.fillRect(QRectF(rect.width() * 0.58, rect.height() * 0.25, rect.width() * 0.04, rect.height() * 0.45), QColor("#1d2331"))

            # Thermal scanlines
            p.setPen(QPen(QColor(0, 0, 0, 35), 1))
            for y in range(0, rect.height(), 4):
                p.drawLine(0, y, rect.width(), y)

            # 2. Thermal Human Heat Bodies (White / Hot silhouettes)
            targets = [
                (rect.width() * 0.33, rect.height() * 0.42, 28, 56, "AI: S01 · 93%"),
                (rect.width() * 0.60, rect.height() * 0.32, 22, 46, "AI: S02 · 85%"),
                (rect.width() * 0.72, rect.height() * 0.34, 20, 44, "AI: T3 · 77%"),
            ]

            for tx, ty, tw, th, t_label in targets:
                # White-hot glow center
                body_grad = QRadialGradient(QPointF(tx + tw / 2, ty + th * 0.4), th * 0.6)
                body_grad.setColorAt(0, QColor(255, 255, 255, 240))
                body_grad.setColorAt(0.35, QColor(220, 235, 245, 180))
                body_grad.setColorAt(0.75, QColor(90, 120, 150, 90))
                body_grad.setColorAt(1, QColor(30, 45, 60, 0))
                p.setBrush(QBrush(body_grad))
                p.setPen(Qt.PenStyle.NoPen)
                p.drawEllipse(QRectF(tx, ty, tw, th))

                # Human silhouette head & torso
                p.setBrush(QBrush(QColor(250, 252, 255, 230)))
                head_r = tw * 0.28
                p.drawEllipse(QPointF(tx + tw / 2, ty + head_r), head_r, head_r)
                p.drawRoundedRect(QRectF(tx + tw * 0.2, ty + head_r * 2, tw * 0.6, th * 0.55), 3, 3)

                # AI Bounding Box
                if self.ai_enabled:
                    box_rect = QRectF(tx - 6, ty - 6, tw + 12, th + 12)
                    p.setPen(QPen(QColor("#00f2fe"), 1.6))
                    p.setBrush(Qt.BrushStyle.NoBrush)

                    # Corner brackets
                    bl, bt, br, bb = box_rect.left(), box_rect.top(), box_rect.right(), box_rect.bottom()
                    cs = 6
                    # Top-left
                    p.drawLine(QPointF(bl, bt), QPointF(bl + cs, bt))
                    p.drawLine(QPointF(bl, bt), QPointF(bl, bt + cs))
                    # Top-right
                    p.drawLine(QPointF(br, bt), QPointF(br - cs, bt))
                    p.drawLine(QPointF(br, bt), QPointF(br, bt + cs))
                    # Bottom-left
                    p.drawLine(QPointF(bl, bb), QPointF(bl + cs, bb))
                    p.drawLine(QPointF(bl, bb), QPointF(bl, bb - cs))
                    # Bottom-right
                    p.drawLine(QPointF(br, bb), QPointF(br - cs, bb))
                    p.drawLine(QPointF(br, bb), QPointF(br, bb - cs))

                    # Full subtle border
                    p.setPen(QPen(QColor(0, 242, 254, 80), 1, Qt.PenStyle.DashLine))
                    p.drawRect(box_rect)

                    # Tag label
                    tag_bg = QRectF(bl, bt - 13, max(68, len(t_label) * 6), 12)
                    p.fillRect(tag_bg, QColor(0, 242, 254, 210))
                    p.setPen(QColor("#0a0f1d"))
                    p.setFont(QFont("Segoe UI", 6, QFont.Weight.Bold))
                    p.drawText(tag_bg.adjusted(2, 0, 0, 0), Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, t_label)

        else:
            # OPTICAL High-Def Mode
            opt_gradient = QLinearGradient(QPointF(rect.topLeft()), QPointF(rect.bottomRight()))
            opt_gradient.setColorAt(0, QColor("#1e293b"))
            opt_gradient.setColorAt(1, QColor("#0f172a"))
            p.fillRect(rect, opt_gradient)

            # Room background structures
            p.fillRect(QRectF(0, rect.height() * 0.45, rect.width(), rect.height() * 0.55), QColor("#334155"))
            p.fillRect(QRectF(rect.width() * 0.15, rect.height() * 0.2, rect.width() * 0.08, rect.height() * 0.8), QColor("#475569"))
            p.fillRect(QRectF(rect.width() * 0.75, rect.height() * 0.2, rect.width() * 0.08, rect.height() * 0.8), QColor("#475569"))

            # Targets in optical mode
            p.setBrush(QBrush(QColor("#e2e8f0")))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawEllipse(QRectF(rect.width() * 0.35, rect.height() * 0.45, 24, 48))
            p.drawEllipse(QRectF(rect.width() * 0.62, rect.height() * 0.35, 18, 38))

            if self.ai_enabled:
                for bx, by, bw, bh, blabel in [
                    (rect.width() * 0.35 - 5, rect.height() * 0.45 - 5, 34, 58, "AI: S01 · 93%"),
                    (rect.width() * 0.62 - 5, rect.height() * 0.35 - 5, 28, 48, "AI: S02 · 85%"),
                ]:
                    p.setPen(QPen(QColor("#00f2fe"), 1.5))
                    p.drawRect(QRectF(bx, by, bw, bh))
                    p.fillRect(QRectF(bx, by - 12, 65, 12), QColor(0, 242, 254, 210))
                    p.setPen(QColor("#000000"))
                    p.setFont(QFont("Segoe UI", 6, QFont.Weight.Bold))
                    p.drawText(QRectF(bx, by - 12, 65, 12), Qt.AlignmentFlag.AlignCenter, blabel)

        # 3. Reticle and Crosshair (Common HUD)
        cx, cy = rect.center().x(), rect.center().y()
        p.setPen(QPen(QColor(255, 255, 255, 70), 1))
        p.drawLine(QPointF(cx - 14, cy), QPointF(cx - 4, cy))
        p.drawLine(QPointF(cx + 4, cy), QPointF(cx + 14, cy))
        p.drawLine(QPointF(cx, cy - 14), QPointF(cx, cy - 4))
        p.drawLine(QPointF(cx, cy + 4), QPointF(cx, cy + 14))
        p.drawEllipse(QPointF(cx, cy), 16, 16)

        # 4. HUD On-Screen Diagnostics
        p.setFont(QFont("Segoe UI", 6, QFont.Weight.Bold))
        # Top-left Recording Indicator
        pulse_alpha = 180 + int(70 * math.sin(self.anim_tick * 0.2))
        p.setBrush(QBrush(QColor(239, 68, 68, pulse_alpha)))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawEllipse(QPointF(12, 12), 4, 4)

        p.setPen(QColor("#ef4444"))
        p.drawText(20, 16, self.mode)

        # Top-right OSD
        p.setPen(QColor(255, 255, 255, 170))
        p.drawText(rect.width() - 85, 16, "1280×720 · 30FPS")

        # Bottom-left and Bottom-right status
        p.setPen(QColor(255, 255, 255, 140))
        p.drawText(10, rect.height() - 8, "JETSON ORIN AI FEED")
        p.drawText(rect.width() - 50, rect.height() - 8, f"{self.zoom}% ZOOM")

        p.end()


class PilotViewDialog(QDialog):
    """Expanded preview dialog of the synthetic drone camera feed."""

    mode_changed = pyqtSignal(str)
    zoom_changed = pyqtSignal(int)

    def __init__(self, mode: str, zoom: int, parent=None) -> None:
        super().__init__(parent)
        self.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)
        self.setWindowTitle("NIDAR Drone Camera — Pilot View")
        self.resize(920, 600)
        self.setStyleSheet(f"background:{PALETTE['bg']}; color:{PALETTE['ink']}; font-family:'Segoe UI';")
        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(10)

        header = QHBoxLayout()
        header.addWidget(label("DRONE PILOT VIEW", 11, True))
        mode_chip = label(f"● {mode}", 8, True, PALETTE["cyan"])
        header.addWidget(mode_chip)
        header.addStretch()
        layout.addLayout(header)

        self.camera = CameraSurface()
        self.camera.setMinimumSize(880, 480)
        self.camera.set_mode(mode)
        self.camera.zoom = zoom
        self.camera.mode_changed.connect(self.mode_changed.emit)
        layout.addWidget(self.camera, 1)

        controls = QHBoxLayout()
        toggle = QPushButton("SWITCH THERMAL / OPTICAL")
        toggle.clicked.connect(self.camera.toggle_mode)
        controls.addWidget(toggle)

        ai_btn = QPushButton("TOGGLE AI BOUNDING BOXES")
        ai_btn.clicked.connect(lambda: setattr(self.camera, "ai_enabled", not self.camera.ai_enabled) or self.camera.update())
        controls.addWidget(ai_btn)

        controls.addWidget(label("ZOOM", 7, True, PALETTE["muted"]))
        self.zoom = QSlider(Qt.Orientation.Horizontal)
        self.zoom.setRange(70, 130)
        self.zoom.setValue(zoom)
        self.zoom.valueChanged.connect(self._set_zoom)
        controls.addWidget(self.zoom, 1)

        self.zoom_value = label(f"{zoom}%", 8, True)
        controls.addWidget(self.zoom_value)

        close = QPushButton("CLOSE")
        close.clicked.connect(self.close)
        controls.addWidget(close)
        layout.addLayout(controls)

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.camera.tick)
        self.timer.start(40)

    def _set_zoom(self, value: int) -> None:
        self.camera.zoom = value
        self.camera.update()
        self.zoom_value.setText(f"{value}%")
        self.zoom_changed.emit(value)

    def sync_mode(self, mode: str) -> None:
        self.camera.set_mode(mode)

    def sync_zoom(self, value: int) -> None:
        if self.zoom.value() != value:
            self.zoom.setValue(value)


