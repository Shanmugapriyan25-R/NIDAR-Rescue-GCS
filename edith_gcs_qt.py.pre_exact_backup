class MapCanvas(QWidget):
    """High-visibility light-themed 2D SLAM LiDAR Arena with metric grid and rotating scan sweep."""

    def __init__(self) -> None:
        super().__init__()
        self.setMinimumSize(440, 300)
        self.frame: Dict[str, Any] = default_frame()
        self.route = list(SIMULATION_ROUTE)
        self.scan_angle = 45.0  # Rotating scan beam angle
        self.pulse_phase = 0.0

    def tick(self) -> None:
        # Smooth rotation of the 360 LiDAR scan cone (10 Hz equivalent)
        self.scan_angle = (self.scan_angle + 4.5) % 360.0
        self.pulse_phase = (self.pulse_phase + 0.12) % (2 * math.pi)
        self.update()

    def set_frame(self, frame: Dict[str, Any]) -> None:
        self.frame = frame
        self.update()

    def _area(self) -> QRectF:
        # Leave room for A-O labels top/bottom and 1-15 labels left/right
        available = self.rect().adjusted(28, 24, -28, -24)
        ratio = 1.38
        width = min(available.width(), available.height() * ratio)
        height = width / ratio
        return QRectF(available.center().x() - width / 2, available.center().y() - height / 2, width, height)

    def _point(self, x: float, y: float, area: QRectF) -> QPointF:
        return QPointF(area.left() + x / 15.0 * area.width(), area.bottom() - y / 15.0 * area.height())

    def paintEvent(self, event) -> None:  # type: ignore[override]
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        # 1. Canvas Outer Background (Clean light technical slate)
        p.fillRect(self.rect(), QColor(PALETTE["bg"]))

        area = self._area()

        # 2. Arena Floor
        p.fillRect(area, QColor(PALETTE["arena_bg"]))

        # 3. 15x15 Metric Grid Lines
        p.setPen(QPen(QColor(PALETTE["line_dark"]), 1, Qt.PenStyle.SolidLine))
        for i in range(16):
            x = area.left() + i / 15.0 * area.width()
            p.drawLine(QPointF(x, area.top()), QPointF(x, area.bottom()))
        for i in range(16):
            y = area.top() + i / 15.0 * area.height()
            p.drawLine(QPointF(area.left(), y), QPointF(area.right(), y))

        # 4. Metric Grid Coordinate Labels (A–O Columns, 1–15 Rows)
        p.setPen(QColor(PALETTE["ink"]))
        p.setFont(QFont("Segoe UI", 6, QFont.Weight.Bold))
        col_letters = "ABCDEFGHIJKLMNO"

        # Column letters (top and bottom)
        for i, letter in enumerate(col_letters):
            x = area.left() + (i + 0.5) / 15.0 * area.width()
            p.drawText(QRectF(x - 8, area.top() - 18, 16, 14), Qt.AlignmentFlag.AlignCenter, letter)
            p.drawText(QRectF(x - 8, area.bottom() + 4, 16, 14), Qt.AlignmentFlag.AlignCenter, letter)

        # Row numbers (left and right)
        for i in range(15):
            row_num = str(15 - i)
            y = area.top() + (i + 0.5) / 15.0 * area.height()
            p.drawText(QRectF(area.left() - 24, y - 7, 20, 14), Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter, row_num)
            p.drawText(QRectF(area.right() + 4, y - 7, 20, 14), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, row_num)

        # 5. Mapped Free-Space Corridor (High contrast white surface)
        def occupancy_polygon(points: list[tuple[float, float]]) -> QPolygonF:
            return QPolygonF([QPointF(area.left() + x * area.width(), area.top() + y * area.height()) for x, y in points])

        free_space = occupancy_polygon([
            (0.04, 0.04), (0.48, 0.04), (0.50, 0.20), (0.94, 0.20), (0.96, 0.88),
            (0.86, 0.88), (0.85, 0.78), (0.72, 0.78), (0.71, 0.90), (0.60, 0.90),
            (0.58, 0.80), (0.43, 0.80), (0.42, 0.92), (0.26, 0.92), (0.23, 0.85),
            (0.08, 0.86), (0.08, 0.70), (0.03, 0.69), (0.04, 0.50), (0.09, 0.49),
            (0.09, 0.35), (0.04, 0.34),
        ])
        p.setBrush(QBrush(QColor(PALETTE["arena_free"])))
        p.setPen(QPen(QColor(PALETTE["line_dark"]), 2.2))
        p.drawPolygon(free_space)

        # 6. Obstacles / Walls (Solid high-contrast dark slate)
        obstacles = [
            [(0.16, 0.27), (0.35, 0.27), (0.36, 0.38), (0.26, 0.39), (0.25, 0.34), (0.16, 0.34)],
            [(0.16, 0.58), (0.36, 0.58), (0.36, 0.65), (0.27, 0.65), (0.26, 0.71), (0.16, 0.70)],
            [(0.49, 0.23), (0.52, 0.23), (0.52, 0.40), (0.49, 0.40)],
            [(0.57, 0.61), (0.78, 0.61), (0.78, 0.70), (0.65, 0.70), (0.64, 0.66), (0.57, 0.66)],
        ]
        p.setBrush(QBrush(QColor(PALETTE["arena_obstacle"])))
        p.setPen(QPen(QColor("#0f172a"), 2))
        for obstacle in obstacles:
            p.drawPolygon(occupancy_polygon(obstacle))

        # Small obstacle pillars
        for x, y, width, height in ((.13, .17, .02, .06), (.39, .10, .025, .035), (.76, .32, .02, .02), (.82, .51, .015, .02), (.47, .78, .02, .02), (.88, .45, .015, .015)):
            p.fillRect(QRectF(area.left() + x * area.width(), area.top() + y * area.height(), width * area.width(), height * area.height()), QColor("#0f172a"))

        # 7. LiDAR Obstacle Point Cloud Scatter (Cyan & Teal Dots)
        p.setBrush(QBrush(QColor(PALETTE["point_cloud"])))
        p.setPen(Qt.PenStyle.NoPen)
        scatter_points = [
            (0.15, 0.26), (0.18, 0.26), (0.22, 0.26), (0.30, 0.26), (0.35, 0.26),
            (0.15, 0.35), (0.19, 0.35), (0.24, 0.35), (0.36, 0.39), (0.26, 0.40),
            (0.15, 0.57), (0.20, 0.57), (0.28, 0.57), (0.36, 0.57), (0.36, 0.66),
            (0.57, 0.60), (0.65, 0.60), (0.72, 0.60), (0.78, 0.60), (0.78, 0.71),
            (0.48, 0.22), (0.53, 0.22), (0.48, 0.41), (0.53, 0.41),
        ]
        for sx, sy in scatter_points:
            p.drawEllipse(QPointF(area.left() + sx * area.width(), area.top() + sy * area.height()), 1.8, 1.8)

        # 8. Flight Trajectory Ribbon (Glowing Gradient Path)
        path = [self._point(x, y, area) for x, y in self.route]
        if len(path) > 1:
            # Subtle glow outer line
            p.setPen(QPen(QColor(37, 99, 235, 50), 7, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin))
            for first, second in zip(path, path[1:]):
                p.drawLine(first, second)

            # High-visibility vibrant cyan/blue ribbon
            p.setPen(QPen(QColor("#0284c7"), 3.2, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin))
            for first, second in zip(path, path[1:]):
                p.drawLine(first, second)

            # Start point
            p.setBrush(QBrush(QColor("#2563eb")))
            p.setPen(QPen(QColor("#ffffff"), 1.8))
            p.drawEllipse(path[0], 4.5, 4.5)
            p.setFont(QFont("Segoe UI", 6, QFont.Weight.Bold))
            p.setPen(QColor(PALETTE["blue"]))
            p.drawText(path[0] + QPointF(6, -2), "START")

        # 9. Drone Position & Rotating LiDAR Scan Sweep Cone
        drone = self.frame.get("drone", {})
        dp = self._point(float(drone.get("x", 7.5)), float(drone.get("y", 7.0)), area)
        heading_deg = float(drone.get("heading", 0))

        # Animated Rotating LiDAR 360 Scan Cone (Image 3 style)
        sweep_rad = 54.0
        cone_angle = 50.0  # Cone breadth
        p.save()
        p.translate(dp)
        p.rotate(-self.scan_angle)

        cone_path = QPainterPath()
        cone_path.moveTo(0, 0)
        cone_path.arcTo(QRectF(-sweep_rad, -sweep_rad, sweep_rad * 2, sweep_rad * 2), -cone_angle / 2, cone_angle)
        cone_path.closeSubpath()

        cone_grad = QRadialGradient(0, 0, sweep_rad)
        cone_grad.setColorAt(0, QColor(2, 132, 199, 130))
        cone_grad.setColorAt(0.7, QColor(2, 132, 199, 50))
        cone_grad.setColorAt(1, QColor(2, 132, 199, 0))
        p.setBrush(QBrush(cone_grad))
        p.setPen(QPen(QColor(2, 132, 199, 160), 1.2))
        p.drawPath(cone_path)
        p.restore()

        # Drone Pulse Ring
        pulse_r = 10.0 + 3.0 * math.sin(self.pulse_phase)
        p.setPen(QPen(QColor(2, 132, 199, 120), 1.5))
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.drawEllipse(dp, pulse_r, pulse_r)

        # Drone Arrowhead Icon
        heading_rad = math.radians(heading_deg)
        triangle = [
            dp + QPointF(math.cos(heading_rad) * 11, -math.sin(heading_rad) * 11),
            dp + QPointF(math.cos(heading_rad + 2.45) * 8, -math.sin(heading_rad + 2.45) * 8),
            dp + QPointF(math.cos(heading_rad - 2.45) * 8, -math.sin(heading_rad - 2.45) * 8),
        ]
        p.setPen(QPen(QColor("#ffffff"), 1.6))
        p.setBrush(QBrush(QColor("#2563eb")))
        p.drawPolygon(triangle)

        # Drone Information Tag
        tip = QRectF(dp.x() + 12, dp.y() - 22, 90, 22)
        p.setBrush(QBrush(QColor(255, 255, 255, 235)))
        p.setPen(QPen(QColor(PALETTE["blue"]), 1.2))
        p.drawRoundedRect(tip, 3, 3)
        p.setPen(QColor(PALETTE["ink"]))
        p.setFont(QFont("Segoe UI", 6, QFont.Weight.Bold))
        p.drawText(tip.adjusted(4, 2, -2, -2), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop, f"DRONE · {int(heading_deg)}° HDG")
        p.setFont(QFont("Segoe UI", 5))
        p.drawText(tip.adjusted(4, 11, -2, -2), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop, f"{drone.get('speed', 0):.2f}m/s · {drone.get('altitude', 0):.1f}m")

        # 10. Survivor Localization Badges (S01–S06)
        for survivor in self.frame.get("survivors", []):
            if survivor.get("status") != "found":
                continue
            pt = self._point(float(survivor.get("x", 0)), float(survivor.get("y", 0)), area)

            # Pulsing target rings
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.setPen(QPen(QColor(16, 185, 129, 160), 1.4, Qt.PenStyle.DashLine))
            p.drawEllipse(pt, 9, 9)

            p.setBrush(QBrush(QColor(PALETTE["green"])))
            p.setPen(QPen(QColor("#ffffff"), 1.8))
            p.drawEllipse(pt, 5, 5)

            # Tag bubble
            bubble = QRectF(pt.x() + 8, pt.y() - 10, 44, 16)
            p.setBrush(QBrush(QColor("#ffffff")))
            p.setPen(QPen(QColor(PALETTE["green"]), 1.4))
            p.drawRoundedRect(bubble, 3, 3)
            p.setPen(QColor(PALETTE["ink"]))
            p.setFont(QFont("Segoe UI", 6, QFont.Weight.Bold))
            p.drawText(bubble, Qt.AlignmentFlag.AlignCenter, f"{survivor.get('id', 'S')} [{survivor.get('grid', '—')}]")

        # 11. Bottom Arena Legend
        legend = QRectF(area.right() - 120, area.bottom() - 30, 115, 24)
        p.setBrush(QBrush(QColor(255, 255, 255, 240)))
        p.setPen(QPen(QColor(PALETTE["line"]), 1))
        p.drawRoundedRect(legend, 3, 3)
        p.setPen(QPen(QColor("#0284c7"), 2.2))
        p.drawLine(QPointF(legend.left() + 7, legend.top() + 12), QPointF(legend.left() + 28, legend.top() + 12))
        p.setPen(QColor(PALETTE["ink"]))
        p.setFont(QFont("Segoe UI", 6, QFont.Weight.Bold))
        p.drawText(QPointF(legend.left() + 34, legend.top() + 11), "FLIGHT RIBBON")
        p.setFont(QFont("Segoe UI", 5))
        p.drawText(QPointF(legend.left() + 34, legend.top() + 19), "1m METRIC GRID")

        p.end()


