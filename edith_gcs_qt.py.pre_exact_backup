            self.badge.setStyleSheet("""
                background-color: #f59e0b;
                color: #ffffff;
                border-radius: 11px;
                font-size: 11px;
                font-weight: bold;
            """)
        else:
            self.badge.setText("✖")
            self.badge.setStyleSheet("""
                background-color: #ef4444;
                color: #ffffff;
                border-radius: 11px;
                font-size: 11px;
